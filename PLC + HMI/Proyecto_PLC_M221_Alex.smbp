    <MemoryBits>
      <MemoryBit>
        <Address>%M100</Address>
        <Index>100</Index>
        <Symbol>AUTO</Symbol>
        <Comment>Bit para poner el modo automatico</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M101</Address>
        <Index>101</Index>
        <Symbol>G_QCINTA1</Symbol>
        <Comment>Bit para el control del modo manual</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M102</Address>
        <Index>102</Index>
        <Symbol>G_QCINTA2</Symbol>
        <Comment>Bit para el control del modo manual</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M103</Address>
        <Index>103</Index>
        <Symbol>G_QCINTA3</Symbol>
        <Comment>Bit para el control del modo manual</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M104</Address>
        <Index>104</Index>
        <Symbol>G_QCINTA4</Symbol>
        <Comment>Bit para el control del modo manual</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M105</Address>
        <Index>105</Index>
        <Symbol>G_QMAC1</Symbol>
        <Comment>Bit para el control del modo manual</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M106</Address>
        <Index>106</Index>
        <Symbol>G_QMAC2</Symbol>
        <Comment>Bit para el control del modo manual</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M107</Address>
        <Index>107</Index>
        <Symbol>G_QSEL1AVANZA</Symbol>
        <Comment>Bit para el control del modo manual</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M108</Address>
        <Index>108</Index>
        <Symbol>G_QSEL1RETRO</Symbol>
        <Comment>Bit para el control del modo manual</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M109</Address>
        <Index>109</Index>
        <Symbol>G_QSEL2AVANZA</Symbol>
        <Comment>Bit para el control del modo manual</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M110</Address>
        <Index>110</Index>
        <Symbol>G_QSEL2RETRO</Symbol>
        <Comment>Bit para el control del modo manual</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M111</Address>
        <Index>111</Index>
        <Symbol>MARCHA</Symbol>
      </MemoryBit>
      <MemoryBit>
        <Address>%M112</Address>
        <Index>112</Index>
        <Symbol>EMERGENCIA</Symbol>
        <Comment>Bit emergencia</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M113</Address>
        <Index>113</Index>
        <Symbol>REARME</Symbol>
        <Comment>Bit de rearme</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M200</Address>
        <Index>200</Index>
        <Symbol>ESTOY_EMERG</Symbol>
        <Comment>Bit que indica que esta en emergencia</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M201</Address>
        <Index>201</Index>
        <Symbol>ESTOY_MANUAL</Symbol>
        <Comment>Bit para indicar cuando estamos en manual</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M202</Address>
        <Index>202</Index>
        <Symbol>ESTOY_AUTO</Symbol>
        <Comment>Bit que indica cuando esta en modo automatico</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M300</Address>
        <Index>300</Index>
        <Symbol>PROBLEMAC1</Symbol>
        <Comment>Problema en cinta 1</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M301</Address>
        <Index>301</Index>
        <Symbol>PROBLEMAC2</Symbol>
        <Comment>Problema en cinta 2</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M302</Address>
        <Index>302</Index>
        <Symbol>PROBLEMAC3</Symbol>
        <Comment>Problema en cinta 3</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M303</Address>
        <Index>303</Index>
        <Symbol>PROBLEMAC4</Symbol>
        <Comment>Problema en cinta 4</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M304</Address>
        <Index>304</Index>
        <Symbol>PROBLEMA_MQ1</Symbol>
        <Comment>Problema en maquina 1</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%M305</Address>
        <Index>305</Index>
        <Symbol>PROBLEMA_MQ2</Symbol>
        <Comment>Problema en maquina 2</Comment>
      </MemoryBit>
    </MemoryBits>
    <SystemBits>
      <MemoryBit>
        <Address>%S0</Address>
        <Index>0</Index>
        <Symbol>SB_COLDSTART</Symbol>
        <Comment>Indica o ejecuta un arranque en frío (datos inicializados a los valores predeterminados)</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S1</Address>
        <Index>1</Index>
        <Symbol>SB_WARMSTART</Symbol>
        <Comment>Indica que se ha producido un arranque en caliente con copia de seguridad de los datos</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S4</Address>
        <Index>4</Index>
        <Symbol>SB_TB10MS</Symbol>
        <Comment>Base de tiempo de 10 ms generada por un reloj interno</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S5</Address>
        <Index>5</Index>
        <Symbol>SB_TB100MS</Symbol>
        <Comment>Base de tiempo de 100 ms generada por un reloj interno</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S6</Address>
        <Index>6</Index>
        <Symbol>SB_TB1S</Symbol>
        <Comment>Base de tiempo de 1 s generada por un reloj interno</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S7</Address>
        <Index>7</Index>
        <Symbol>SB_TB1MIN</Symbol>
        <Comment>Base de tiempo de 1 min generada por un reloj interno</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S9</Address>
        <Index>9</Index>
        <Symbol>SB_FALLBACKOUTPUT</Symbol>
        <Comment>Establézcalo en 1 para aplicar retornos en salidas digitales y analógicas</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S10</Address>
        <Index>10</Index>
        <Symbol>SB_IOCOMBUS</Symbol>
        <Comment>Comunicación de E/S correcta (1), error detectado en comunicación de E/S (0)</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S11</Address>
        <Index>11</Index>
        <Symbol>SB_WATCHDOG</Symbol>
        <Comment>El desborde de watchdog hace que el autómata cambie al modo de detención</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S12</Address>
        <Index>12</Index>
        <Symbol>SB_RUNMODE</Symbol>
        <Comment>El controlador se está ejecutando</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S13</Address>
        <Index>13</Index>
        <Symbol>SB_FIRSTRUN</Symbol>
        <Comment>Indica el primer ciclo del controlador en modalidad RUN</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S14</Address>
        <Index>14</Index>
        <Symbol>SB_IOFORCED</Symbol>
        <Comment>Este bit indica que al menos hay una entrada o salida forzada</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S15</Address>
        <Index>15</Index>
        <Symbol>SB_INFORCED</Symbol>
        <Comment>Este bit indica que al menos hay una entrada forzada</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S16</Address>
        <Index>16</Index>
        <Symbol>SB_OUTFORCED</Symbol>
        <Comment>Este bit indica que al menos hay una salida forzada</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S17</Address>
        <Index>17</Index>
        <Symbol>SB_LASTBIT</Symbol>
        <Comment>Indica el valor del último bit expulsado</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S18</Address>
        <Index>18</Index>
        <Symbol>SB_OPERROR</Symbol>
        <Comment>Indica un desborde cuando se realiza una operación de 16 bits</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S19</Address>
        <Index>19</Index>
        <Symbol>SB_OVERRUN</Symbol>
        <Comment>Indica que el tiempo de exploración es mayor que el periodo definido por el usuario</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S20</Address>
        <Index>20</Index>
        <Symbol>SB_INDERROR</Symbol>
        <Comment>Indica un desborde de índice de la dirección de objeto indexado cuando se realiza una operación de 16 bits</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S21</Address>
        <Index>21</Index>
        <Symbol>SB_INITGRAFCET</Symbol>
        <Comment>En el estado 1, este bit provoca una inicialización GRAFCET. Los pasos activos se desactivan y los pasos iniciales se activan</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S22</Address>
        <Index>22</Index>
        <Symbol>SB_RESETGRAFCET</Symbol>
        <Comment>En el estado 1, este bit provoca la desactivación de los pasos activos de todo el GRAFCET</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S23</Address>
        <Index>23</Index>
        <Symbol>SB_FREEZEGRAFCET</Symbol>
        <Comment>Cuando es 1, valida el posicionamiento previo del GRAFCET. Si se mantiene este bit en 1, se inmoviliza el GRAFCET (se inmoviliza el gráfico)</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S28</Address>
        <Index>28</Index>
        <Symbol>SB_STRERROR</Symbol>
        <Comment>Si se establece en 1, indica que hay un desborde en un objeto de memoria al gestionar las cadenas</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S33</Address>
        <Index>33</Index>
        <Symbol>SB_CONFETH</Symbol>
        <Comment>Cuando es 1 (si no existe una configuración de Post en uso), este bit permite establecer una nueva configuración de Ethernet por %SW33 a %SW38</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S34</Address>
        <Index>34</Index>
        <Symbol>SB_AUTOETH</Symbol>
        <Comment>Cuando es 1, este bit permite forzar algunas configuraciones específicas de Ethernet establecidas en %S35 y %S36</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S35</Address>
        <Index>35</Index>
        <Symbol>SB_DUPLEXMODE</Symbol>
        <Comment>Este bit indica el modo Ethernet dúplex. Es 0 en caso de semidúplex, y 1 en caso de dúplex completo</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S36</Address>
        <Index>36</Index>
        <Symbol>SB_SPEEDETH</Symbol>
        <Comment>Este bit indica la velocidad Ethernet. Se establece en 0 si la velocidad es de 10 Mbps, y en 1 si es de 100 Mbps</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S38</Address>
        <Index>38</Index>
        <Symbol>SB_ALLOWEVENT</Symbol>
        <Comment>Este bit indica si los eventos se colocan en la cola de eventos en cuanto se detectan</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S39</Address>
        <Index>39</Index>
        <Symbol>SB_LOSTEVENT</Symbol>
        <Comment>Este bit indica si hay una saturación de la cola de eventos</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S49</Address>
        <Index>49</Index>
        <Symbol>SB_REARMOUTPUTS</Symbol>
        <Comment>Cuando es 1, se habilita el restablecimiento automático de salidas tras un cortocircuito</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S50</Address>
        <Index>50</Index>
        <Symbol>SB_RTCUPDATE</Symbol>
        <Comment>Cuando es 1, este bit permite actualizar la fecha y la hora</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S51</Address>
        <Index>51</Index>
        <Symbol>SB_RTCSTATUS</Symbol>
        <Comment>Cuando es 1, el usuario debe inicializar la fecha y la hora</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S52</Address>
        <Index>52</Index>
        <Symbol>SB_RTCERROR</Symbol>
        <Comment>Cuando el estado es 1, la fecha y la hora deben inicializarse</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S59</Address>
        <Index>59</Index>
        <Symbol>SB_DATEUPDATE</Symbol>
        <Comment>Cuando es 1, la fecha y la hora aumentan o disminuyen en función de los flancos ascendentes en los bits de control establecidos en %SW59</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S66</Address>
        <Index>66</Index>
        <Symbol>SB_BATLED_DIS</Symbol>
        <Comment>Desactiva el indicador LED de batería cuando está establecido en 1</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S75</Address>
        <Index>75</Index>
        <Symbol>SB_BATSTATUS</Symbol>
        <Comment>Cuando es 1, la alimentación de la batería externa es baja o no se detecta la batería</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S90</Address>
        <Index>90</Index>
        <Symbol>SB_BKUP_TO_SD</Symbol>
        <Comment>Copia de seguridad/restauración de valores de memoria de/a memoria no volátil (0, predeterminado) o de/a tarjeta SD (1)</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S91</Address>
        <Index>91</Index>
        <Symbol>SB_MWERASE</Symbol>
        <Comment>Establezca este bit en 1 para borrar todos los valores de memoria en la memoria no volátil</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S92</Address>
        <Index>92</Index>
        <Symbol>SB_MWSAVED</Symbol>
        <Comment>Establezca este bit en 1 si hay valores de memoria válidos guardados en la memoria no volátil</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S93</Address>
        <Index>93</Index>
        <Symbol>SB_MWBACKUP</Symbol>
        <Comment>Establezca este bit en 1 para hacer una copia de seguridad de los valores de memoria en la memoria no volátil (%S90 = 0) o en la tarjeta SD (%S90 = 1)</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S94</Address>
        <Index>94</Index>
        <Symbol>SB_MWRESTORE</Symbol>
        <Comment>Establezca este bit en 1 para restaurar los valores de memoria de la memoria no volátil (%S90 = 0) o la tarjeta SD (%S90 = 1)</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S96</Address>
        <Index>96</Index>
        <Symbol>SB_PROGBACKUP</Symbol>
        <Comment>Cuando es 1, el programa de copia de seguridad es válido</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S101</Address>
        <Index>101</Index>
        <Symbol>SB_MBADDRESS</Symbol>
        <Comment>Cuando es 1, puede cambiarse la dirección modificando los valores de %SW101 (puerto 1) o %SW102 (puerto 2)</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S103</Address>
        <Index>103</Index>
        <Symbol>SB_ASCIICOM1</Symbol>
        <Comment>Cuando es 1, este bit permite configurar el protocolo ASCII en la línea serie 1</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S104</Address>
        <Index>104</Index>
        <Symbol>SB_ASCIICOM2</Symbol>
        <Comment>Cuando es 1, este bit permite configurar el protocolo ASCII en la línea serie 2</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S105</Address>
        <Index>105</Index>
        <Symbol>SB_MODINIT</Symbol>
        <Comment>Cuando es 1, este bit permite inicializar el módem (consulte también %SW167)</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S106</Address>
        <Index>106</Index>
        <Symbol>SB_IOBUSERRPASSIVE</Symbol>
        <Comment>El valor predeterminado es 0. Cuando es 1, cambia el comportamiento del bus de E/S gestionando los intercambios de módulo E/S incluso en caso de error permanente</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S107</Address>
        <Index>107</Index>
        <Symbol>SB_IOBUSRESTART</Symbol>
        <Comment>El flanco ascendente de este bit permite reconfigurar y reiniciar el bus de E/S</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S110</Address>
        <Index>110</Index>
        <Symbol>SB_IOSCAN1RESET</Symbol>
        <Comment>Se establece en 1 para reiniciar el IOScanner en la línea serie 1</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S111</Address>
        <Index>111</Index>
        <Symbol>SB_IOSCAN2RESET</Symbol>
        <Comment>Se establece en 1 para reiniciar el IOScanner en la línea serie 2</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S112</Address>
        <Index>112</Index>
        <Symbol>SB_IOSCANETHRESET</Symbol>
        <Comment>Se establece en 1 para reiniciar el IOScanner en Ethernet</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S113</Address>
        <Index>113</Index>
        <Symbol>SB_IOSCAN1SUSPEND</Symbol>
        <Comment>Se establece en 1 para suspender el IOScanner en la línea serie 1</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S114</Address>
        <Index>114</Index>
        <Symbol>SB_IOSCAN2SUSPEND</Symbol>
        <Comment>Se establece en 1 para suspender el IOScanner en la línea serie 2</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S115</Address>
        <Index>115</Index>
        <Symbol>SB_IOSCANETHSUSPEND</Symbol>
        <Comment>Se establece en 1 para suspender el IOScanner en Ethernet</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S119</Address>
        <Index>119</Index>
        <Symbol>SB_IOERROR</Symbol>
        <Comment>Este bit se establece en 0 cuando se detecta una interrupción de comunicación de E/S en el controlador base</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S122</Address>
        <Index>122</Index>
        <Symbol>SB_DALARM</Symbol>
        <Comment>La pantalla cambiará automáticamente a la página de alarma</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S123</Address>
        <Index>123</Index>
        <Symbol>SB_DRED</Symbol>
        <Comment>La retroiluminación de la pantalla se encenderá en color rojo mientras haya una alarma activa</Comment>
      </MemoryBit>
    </SystemBits>
    <SystemWords>
      <MemoryWord>
        <Address>%SW0</Address>
        <Index>0</Index>
        <Symbol>SW_MASTERTASK</Symbol>
        <Comment>Modifica el periodo de ciclo del autómata definido en la configuración mediante el programa de aplicación en el Editor de tablas de animación</Comment>
      </MemoryWord>
      <MemoryWord>
        <Address>%SW1</Address>
        <Index>1</Index>
        <Symbol>SW_PERTASK</Symbol>
        <Comment>Modifica el tiempo de ciclo de la tarea periódica</Comment>
      </MemoryWord>
      <MemoryWord>
        <Address>%SW6</Address>
        <Index>6</Index>
        <Symbol>SW_CONTROLSTATUS</Symbol>
        <Comment>Estado del controlador: NO HAY APLICACION (0), STOP (2), RUN (3), HALT (4), POWERLESS MODE (5)</Comment>
      </MemoryWord>
      <MemoryWord>
        <Address>%SW7</Address>
        <Index>7</Index>
        <Symbol>SW_STATE</Symbol>
        <Comment>Esta palabra muestra el estado del controlador (consulte la ayuda online para obtener más información)</Comment>
      </MemoryWord>
      <MemoryWord>
        <Address>%SW11</Address>
        <Index>11</Index>
        <Symbol>SW_WATCHDOG</Symbol>
        <Comment>Contiene el valor máximo del watchdog</Comment>
      </MemoryWord>
      <MemoryWord>
        <Address>%SW13</Address>
        <Index>13</Index>
        <Symbol>SW_BOOTVERSION</Symbol>
        <Comment>Contiene la versión de arranque del controlador</Comment>
      </MemoryWord>
      <MemoryWord>
        <Address>%SW14</Address>
        <Index>14</Index>
        <Symbol>SW_COMVERSION</Symbol>
        <Comment>Contiene la versión comercial del controlador</Comment>
      </MemoryWord>
      <MemoryWord>
        <Address>%SW15</Address>
        <Index>15</Index>
        <Symbol>SW_FW1VERSION</Symbol>
        <Comment>Contiene la versión de firmware del controlador (primera palabra)</Comment>
      </MemoryWord>
      <MemoryWord>
        <Address>%SW16</Address>
        <Index>16</Index>
        <Symbol>SW_FW2VERSION</Symbol>
        <Comment>Contiene la versión de firmware del controlador (segunda palabra)</Comment>
      </MemoryWord>
      <MemoryWord>
        <Address>%SW17</Address>
        <Index>17</Index>
        <Symbol>SW_FLOATSTATUS</Symbol>
        <Comment>Estado predeterminado cuando se detecta un error en una operación aritmética flotante (consulte la ayuda online para obtener más información)</Comment>
      </MemoryWord>
      <MemoryWord>
        <Address>%SW18</Address>
        <Index>18</Index>
        <Symbol>SW_TM1COUNTER</Symbol>
        <Comment>Contiene el contador del temporizador absoluto (primera palabra)</Comment>
      </MemoryWord>
      <MemoryWord>
        <Address>%SW19</Address>
        <Index>19</Index>
        <Symbol>SW_TM2COUNTER</Symbol>
        <Comment>Contiene el contador del temporizador absoluto (segunda palabra)</Comment>
      </MemoryWord>
      <MemoryWord>
        <Address>%SW30</Address>
        <Index>30</Index>
        <Symbol>SW_LASTSCAN1</Symbol>
        <Comment>Muestra el tiempo de ejecución del último ciclo de exploración del controlador (en ms). Si el tiempo de exploración es 2.250 ms, %SW30 = 2 y %SW70 = 250</Comment>
      </MemoryWord>
      <MemoryWord>
        <Address>%SW31</Address>
        <Index>31</Index>
        <Symbol>SW_MAXSCAN1</Symbol>
        <Comment>Muestra el tiempo de ejecución del ciclo de exploración más largo del controlador (en ms) desde el último inicio en frío. Si el tiempo de exploración es 2.250 ms, %SW31 = 2 y %SW71 = 250</Comment>
      </MemoryWord>
      <MemoryWord>
        <Address>%SW32</Address>
        <Index>32</Index>
        <Symbol>SW_MINSCAN1</Symbol>
        <Comment>Muestra el tiempo de ejecución del ciclo de exploración más corto del controlador (en ms) desde el último arranque en frío. Si el tiempo de exploración es 2.250 ms, %SW32 = 2 y %SW72 = 250</Comment>
